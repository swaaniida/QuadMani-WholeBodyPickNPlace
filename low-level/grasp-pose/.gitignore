# Upload allowlist: runtime files stay on disk but can never enter git add .
/*
!/.gitignore
!/.gitattributes
!/README.md
!/AGENTS.md
!/THIRD_PARTY_NOTICES.md
!/docs/
!/scripts/
!/graspgenx-realsense/
/graspgenx-realsense/*
!/graspgenx-realsense/.gitignore
!/graspgenx-realsense/*.md
!/graspgenx-realsense/configs/
!/graspgenx-realsense/docs/
!/graspgenx-realsense/local_client/
!/graspgenx-realsense/scripts/
!/graspgenx-realsense/server/
!/graspgenx-realsense/tracking_service/
!/graspgenx-realsense/tests/
!/graspgenx-realsense/assets/
# Generated files, private device calibration, recordings and caches
**/__pycache__/
**/.pytest_cache/
**/.venv*/
**/.deps/
**/.cache/
**/.runtime/
**/outputs*/
**/example_results/
**/example_auto_session/
**/*.pyc
**/*.log
**/*.pid
**/*.zip
**/*.pth
**/*.pt
**/*.ckpt
**/*.safetensors
**/*.bag
**/.env
**/.env.*
**/id_ed25519*
**/id_rsa*
**/*.pem
**/*.key
**/realsense_calibration*.json
**/camera_tcp_transform*.json
**/*device_calibrated*.urdf
/graspgenx-realsense/assets/**/*.pdf
