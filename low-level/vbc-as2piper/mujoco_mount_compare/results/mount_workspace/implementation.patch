+#!/usr/bin/env python3
+"""Plot the saved CPU study and render its actual MuJoCo configurations."""
+import json
+from pathlib import Path
+import numpy as np
+import matplotlib
+matplotlib.use('Agg')
+import matplotlib.pyplot as plt
+from PIL import Image,ImageDraw
+import mujoco
+from mount_workspace_study import OUT,setup
+
