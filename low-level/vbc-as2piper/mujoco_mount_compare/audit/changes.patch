+                vertices=vertices*np.array(nums(mesh.get('scale'),'1 1 1'))
+                origin=visual.find('origin');R=np.empty(9)
+                mujoco.mju_quat2Mat(R,np.array([float(x) for x in quat_from_rpy(nums(origin.get('rpy'),'0 0 0')).split()]))
+                vertices=vertices@R.reshape(3,3).T+np.array(nums(origin.get('xyz'),'0 0 0'))
+                bid=mujoco.mj_name2id(model,mujoco.mjtObj.mjOBJ_BODY,finger)
+                _tip_vertices.append((bid,vertices))
+    row['tpu_lowest_z_m']=min(float((v@data.xmat[b].reshape(3,3).T+data.xpos[b])[:,2].min()) for b,v in _tip_vertices)
+    for a in range(model.nu):
+        name=mujoco.mj_id2name(model,mujoco.mjtObj.mjOBJ_ACTUATOR,a)
+        row[name+'_command']=float(data.ctrl[a])
+        jid=int(model.actuator_trnid[a,0])
+        row[name+'_qpos']=float(data.qpos[model.jnt_qposadr[jid]])
+    return row
+
+
+
+def run(args):
