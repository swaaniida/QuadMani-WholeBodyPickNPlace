+    # Aggregate link inertias, excluding the static ground body (body 0).
+    for i in range(1,model.nbody):
+        m=float(model.body_mass[i]);mass+=m
+        for axis in range(3):com[axis]+=m*float(data.xipos[i,axis])
+    if mass>0:com=[x/mass for x in com]
+    row = {'time_s':float(data.time),'base_z_m':float(data.xpos[rootid,2]),
+            'roll_deg':math.degrees(r),'pitch_deg':math.degrees(p),
+            'com_x_m':com[0],'com_y_m':com[1],'com_z_m':com[2],
+            'contacts':int(data.ncon),'sum_abs_joint_torque_Nm':effort[0],
+            'sum_abs_gripper_force_N':effort[1]}
+    import numpy as np
+    ground=mujoco.mj_name2id(model,mujoco.mjtObj.mjOBJ_GEOM,'ground')
+    feet={leg:mujoco.mj_name2id(model,mujoco.mjtObj.mjOBJ_BODY,leg+'_foot') for leg in ('FL','FR','RL','RR')}
+    forces={leg:0. for leg in feet};counts={leg:0 for leg in feet}
+    non_ground=[]
+    for i in range(data.ncon):
+        c=data.contact[i]
+        if ground in (c.geom1,c.geom2):
+            other=c.geom2 if c.geom1==ground else c.geom1
+            for leg,bid in feet.items():
+                if model.geom_bodyid[other]==bid:
+                    f=np.zeros(6);mujoco.mj_contactForce(model,data,i,f)
+                    forces[leg]+=float(f[0]);counts[leg]+=1
+        else:non_ground.append(float(c.dist))
+    for leg in feet:
+        row[leg+'_ground_normal_N']=forces[leg];row[leg+'_ground_contacts']=counts[leg]
+    tcp=mujoco.mj_name2id(model,mujoco.mjtObj.mjOBJ_BODY,'piper_umi_nominal_tcp')
+    row['tcp_z_m']=float(data.xpos[tcp,2])
+    row['base_com_z_m']=float(data.xipos[rootid,2])
+    row['base_x_m']=float(data.xpos[rootid,0]);row['base_y_m']=float(data.xpos[rootid,1])
+    row['yaw_deg']=math.degrees(y)
+    row['mujoco_warning_count']=int(sum(w.number for w in data.warning))
+    row['self_contact_count']=len(non_ground)
+    row['self_min_contact_dist_m']=min(non_ground,default=0.)
+    row['max_abs_joint_velocity']=float(np.max(np.abs(data.qvel[6:])))
+    row['max_abs_actuator_command']=float(np.max(np.abs(data.ctrl)))
+    # Actual transformed TPU vertices, not link6 or only a nominal TCP.
+    from verify_mounts import stl_triangles
+    global _tip_vertices
+    if '_tip_vertices' not in globals():
