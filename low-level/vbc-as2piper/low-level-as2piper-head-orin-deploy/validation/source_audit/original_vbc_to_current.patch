+    def _termination_ground_height(self):
+        if self.cfg.terrain.mesh_type == 'plane':
+            return torch.zeros(self.num_envs, device=self.device)
+        # Sample directly below the body using the existing terrain grid.
+        pixels = ((self.root_states[:, :2] + self.cfg.terrain.border_size) /
+                  self.cfg.terrain.horizontal_scale).long()
+        x = pixels[:, 0].clamp(0, self.height_samples.shape[0] - 2)
+        y = pixels[:, 1].clamp(0, self.height_samples.shape[1] - 2)
+        height = torch.minimum(self.height_samples[x, y], self.height_samples[x + 1, y])
+        height = torch.minimum(height, self.height_samples[x, y + 1])
+        return height * self.cfg.terrain.vertical_scale
