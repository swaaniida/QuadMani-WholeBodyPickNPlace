+class HistoryPolicyExporter(torch.nn.Module):
+    """Deployment input is current proprioception followed by previous frames."""
+    def __init__(self, actor):
+        super().__init__()
+        self.actor = actor
+        self.input_size = actor.num_prop * (actor.num_hist + 1)
+
+    def forward(self, observations: torch.Tensor) -> torch.Tensor:
+        if observations.dim() != 2 or observations.size(1) != self.input_size:
+            raise ValueError("Deployment input must contain current proprioception and history")
+        return self.actor(observations, True)
 
 
